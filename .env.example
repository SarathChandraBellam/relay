# Copy to .env. Every value below is the default, so the file is optional.

# The runner's database (threads, runs, events).
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# The agent keeps its LangGraph checkpoints in its own database.
AGENT_DATABASE_URL=postgresql://relay:relay@localhost:5432/relay_agent

# "scripted" needs no API key. For a real model use LangChain's
# provider:model form and set that provider's key, for example:
#   RELAY_MODEL=anthropic:claude-sonnet-4-5   ANTHROPIC_API_KEY=...
#   RELAY_MODEL=openai:gpt-4.1                OPENAI_API_KEY=...
RELAY_MODEL=scripted

AGENT_URL=http://127.0.0.1:8123/agent
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Runner timings, in milliseconds.
RELAY_LEASE_TTL_MS=15000
RELAY_LEASE_RENEW_MS=5000
RELAY_SWEEP_MS=5000
RELAY_BATCH_MS=50
RELAY_TAIL_POLL_MS=500

COPILOTKIT_TELEMETRY_DISABLED=true
