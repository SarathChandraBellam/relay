{
  "name": "@relay/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../.env src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/runtime": "1.87.0",
    "@hono/node-server": "^2.1.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "rxjs": "7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
